# Copy to .env at the repo root (gitignored). Fill in locally; never commit values.

# Backend WebSocket URL baked into the glasses WebView bundle (no secrets in VITE_ vars); also whitelist its host in glasses/app.json.
VITE_BACKEND_URL=ws://localhost:8787/ws
# Real-G2 build against the Vultr host: `cd glasses && npm run pack:vultr` sets VITE_BACKEND_URL=wss://45-76-173-44.sslip.io/ws
# and needs VITE_FS_TOKEN (the server's FS_TOKEN) in the environment; never write it into a committed file.
FS_TOKEN=
VITE_FS_TOKEN=
VITE_FS_STAFF=
# Gemini API key for the task router (backend/app/router.py). Empty = rules only.
GEMINI_API_KEY=
# Optional: FS_GEMINI_MODEL (default gemini-3.1-flash-lite), FS_ROUTER_TIMEOUT_SEC (default 3),
# FS_DONE_SEC (default 300: an accepted task held this long alerts the manager and is rerouted).
# Optional: FS_FLOOR=demo loads data/floor.demo.json (s1 + mock servers s2-s4, sim/mock_staff.py).
# Tiger Data (TimescaleDB) Postgres URL: every event-log entry is copied to the fs_events hypertable
# (backend/app/eventdb.py, schema backend/app/schema.sql). Empty = in-memory log only.
DATABASE_URL=
# Sentry DSNs (Project settings -> Client Keys). Empty = Sentry off. The web DSN is served by GET /config.
# Optional: SENTRY_ENVIRONMENT (default dev), FS_SENTRY_TRACES_RATE (default 1),
# FS_TRACE_WIRE=1 sends the proposed `trace` field on task.assigned (backend/CONTRACT.md 8.12).
SENTRY_DSN_BACKEND=
SENTRY_DSN_WEB=
# ElevenLabs API key (starts with sk_), used by backend/voice. ElevenLabs dashboard -> Developers -> API Keys; shown once at creation.
ELEVENLABS_API_KEY=
# ElevenLabs agent ID for the voice spike. Printed by backend/voice/create_agent.py (also saved to backend/voice/.agent_id).
ELEVENLABS_AGENT_ID=
# Optional TTS voice for test fixtures. Any voice ID from ElevenLabs -> Voices; defaults to the docs' premade voice.
ELEVENLABS_VOICE_ID=
# Voice relay port (backend/voice/relay.py); default 8790.
VOICE_RELAY_PORT=
# Where the dev fake backend (glasses/dev/voice-proxy.ts) finds the voice relay; default ws://localhost:8790/ws.
VOICE_RELAY_URL=
# Gemini API key, used server-side by backend/voice/gemini_intent.py to map unknown "verity ..." words onto a command. Google AI Studio -> Get API key.
# The relay uses the router's FS_GEMINI_MODEL too; optional FS_INTENT_TIMEOUT_SEC (default 2).
GEMINI_API_KEY=
