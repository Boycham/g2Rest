# Copy to .env at the repo root (gitignored). Fill in locally; never commit values.

# Backend WebSocket URL baked into the glasses WebView bundle (no secrets in VITE_ vars); also whitelist its host in glasses/app.json.
VITE_BACKEND_URL=ws://localhost:8787/ws
# Backend only (voice). Never in a VITE_ var or the WebView bundle.
ELEVENLABS_API_KEY=
